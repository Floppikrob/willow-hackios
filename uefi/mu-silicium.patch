diff --git a/BootShim/BootShim.S b/BootShim/BootShim.S
index 4d208553..3de3972b 100644
--- a/BootShim/BootShim.S
+++ b/BootShim/BootShim.S
@@ -3,12 +3,22 @@ _Head:
   b     _Start          /* Jump to the real code */
 
 #if REQUIRES_KERNEL_HEADER == 1
+#ifdef TEXT_OFFSET
+  /*
+   * The header of a stock Linux Image (willow's ABL hangs on text_offset = FD_BASE): loaded
+   * anywhere in RAM, the shim copies the FD to FD_BASE as usual
+   */
+  .quad TEXT_OFFSET     /* Text Offset */
+  .quad IMAGE_SIZE      /* Image Size: the shim, the FD and the payload (mkxnuimg.py) */
+  .quad 0xA             /* Flags: little-endian, 4K pages, anywhere in RAM */
+#else
 _StackBase:
   .quad FD_BASE         /* Text Offset */
 
 _StackSize:
   .quad FD_SIZE         /* Image Size */
   .quad 0               /* Flags */
+#endif
   .quad 0               /* Reserved */
   .quad 0               /* Reserved */
   .quad 0               /* Reserved */
@@ -28,6 +38,27 @@ _CopyLoop:
   stp   x2, x3, [x5], #16
   subs  x6, x6, #16
   b.ne  _CopyLoop
+
+#ifdef PAYLOAD_BASE
+  /* x4 now points just past the FD: an optional "XNUP" payload may follow */
+  ldr   w2, [x4]
+  movz  w3, #0x4E58
+  movk  w3, #0x5055, lsl #16
+  cmp   w2, w3
+  b.ne  _NoPayload
+  ldr   w6, [x4, #4]    /* Payload Size */
+  add   x6, x6, #23     /* Header + Round Up to 16 */
+  and   x6, x6, #~15
+  movz  x5, #(PAYLOAD_BASE >> 16), lsl #16
+
+_PayloadLoop:
+  ldp   x2, x3, [x4], #16
+  stp   x2, x3, [x5], #16
+  subs  x6, x6, #16
+  b.ne  _PayloadLoop
+
+_NoPayload:
+#endif
   ldr   x5, =FD_BASE
 
 _Entry:
