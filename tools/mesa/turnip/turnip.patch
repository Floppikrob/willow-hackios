+static uint64_t
+continuous_ns(void)
+{
+	static mach_timebase_info_data_t timebase;
+
+	if (timebase.denom == 0) {
+		mach_timebase_info(&timebase);
+	}
+	return mach_continuous_time() * timebase.numer / timebase.denom;
