+   { 252, "MTLPixelFormatDepth32Float",    PIPE_FORMAT_Z32_FLOAT },
+   { 253, "MTLPixelFormatStencil8",        PIPE_FORMAT_S8_UINT },
+   { 260, "MTLPixelFormatDepth32Float_Stencil8", PIPE_FORMAT_Z32_FLOAT_S8X24_UINT },
