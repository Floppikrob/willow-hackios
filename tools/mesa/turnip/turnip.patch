+	pthread_mutex_lock(&syncobjs_lock);
+	if (!valid(handle)) {
+		pthread_mutex_unlock(&syncobjs_lock);
+		return fail(EINVAL);
+	}
+	syncobjs[handle - 1].used = false;
+	pthread_mutex_unlock(&syncobjs_lock);
+	return 0;
+}
+
+static int
+set_state(const uint32_t *handles, uint32_t count, bool signalled)
+{
