--- mesa-25.0.7/src/compiler/air/air_intrinsics.c	1970-01-01 00:00:00.000000000 +0000
+++ mesa-turnip/src/compiler/air/air_intrinsics.c	2026-10-25 16:54:27.145609900 +0000
@@ -0,0 +1,1954 @@
