+	for (uint32_t i = 0; i < count; i++) {
+		if (!valid(handles[i])) {
+			pthread_mutex_unlock(&syncobjs_lock);
+			return fail(EINVAL);
+		}
+		syncobjs[handles[i] - 1].signalled = signalled;
+		syncobjs[handles[i] - 1].fence = 0;
+	}
