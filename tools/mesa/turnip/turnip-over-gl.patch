+#ifdef __APPLE__
+/* Darwin on redwood: the one device, the kernel's GPU service (tu_knl.cc, tu_enumerate_devices). */
+VkResult tu_redwood_load(struct tu_instance *instance, int *fd, struct tu_physical_device **device);
+
+VkResult
+tu_redwood_load(struct tu_instance *instance, int *fd, struct tu_physical_device **device)
+{
+   drmVersionPtr version;
+   VkResult result;
+
+   *fd = drmOpenWithType("msm", NULL, DRM_NODE_RENDER);
+   if (*fd < 0)
+      return VK_ERROR_INCOMPATIBLE_DRIVER;
+   version = drmGetVersion(*fd);
+   if (version == NULL) {
+      close(*fd);
+      return VK_ERROR_INCOMPATIBLE_DRIVER;
+   }
+   result = tu_knl_drm_msm_load(instance, *fd, version, device);
+   drmFreeVersion(version);
+   if (result != VK_SUCCESS)
+      close(*fd);
+   return result;
+}
+#endif
+
